# 镜像名（本地构建或推送到自己的 registry 后填写）
LOCALHUB_IMAGE=localhub:latest

# 对外端口，容器内固定 11030
LOCALHUB_PORT=11030

# 宿主机数据目录：自己选位置，建议独立于 compose 文件目录
# 示例：/volume1/docker/localhub/data 或 /mnt/nas/apps/localhub
LOCALHUB_DATA_DIR=./localhub-data

# 业务进程 UID/GID（入口会把 /data 属主修正为该值）
PUID=1000
PGID=1000

TZ=Asia/Shanghai
LOCALHUB_LOG_LEVEL=info

# —— 管理员与登录（P1.1）——
# 单管理员，首次启动用此口令初始化；初始化成功后建议从 .env 移除
LOCALHUB_ADMIN_USERNAME=admin
LOCALHUB_ADMIN_PASSWORD=
# 会话有效期（5m-720h）
LOCALHUB_SESSION_TTL=12h
# 通过 HTTPS 访问时设为 1（Cookie 仅 HTTPS 传输）
LOCALHUB_COOKIE_SECURE=0
# 登录失败限制：窗口内失败次数 / 窗口 / 锁定时长
LOCALHUB_LOGIN_MAX_FAILURES=5
LOCALHUB_LOGIN_WINDOW=15m
LOCALHUB_LOGIN_LOCKOUT=15m
# 部署在反向代理之后时设为 1，按 X-Forwarded-For 识别客户端 IP
LOCALHUB_TRUST_PROXY=0

# —— Docker 只读集成（P5.1）——
# LocalHub 只通过 Socket Proxy 访问 Docker；留空表示不启用 Docker 集成
LOCALHUB_DOCKER_API_URL=http://docker-socket-proxy:2375
LOCALHUB_DOCKER_TIMEOUT=3s
# 容器列表自动刷新间隔（10s-300s）
LOCALHUB_DOCKER_REFRESH_INTERVAL=30s
# Proxy 镜像；默认固定版本
LOCALHUB_DOCKER_PROXY_IMAGE=wollomatic/socket-proxy:1.14.0
# 宿主机 /var/run/docker.sock 的组 GID；用 stat -c '%g' /var/run/docker.sock 获取
# 不匹配会导致 Docker 状态连接失败/权限不足，但不会影响 LocalHub 其他功能
LOCALHUB_DOCKER_GID=999
# 允许访问 Proxy 的来源；默认仅 Compose 中的 localhub 服务
LOCALHUB_DOCKER_PROXY_ALLOWFROM=localhub
